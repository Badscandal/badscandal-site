# Always-fresh code (beats iPhone caching)
/*
  Cache-Control: no-store, no-cache, must-revalidate

# Media cached hard
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The CLEANSLATE version manifest: the plug-in's CHECK FOR UPDATE and /updatecleanslate read it.
# Root files are already no-store (above); this pins the type and documents the intent.
/cleanslate-version.json
  Cache-Control: no-store, no-cache, must-revalidate
  Content-Type: application/json; charset=utf-8

# The /listen manifest: js/listen.js reads it for every link + the stream total.
# Root files are already no-store (above); this pins the type and documents the intent.
/listen.json
  Cache-Control: no-store, no-cache, must-revalidate
  Content-Type: application/json; charset=utf-8

# The song list (10 Nov 2026): the song pages re-read it for a track link added on release day.
/songs.json
  Cache-Control: no-store, no-cache, must-revalidate
  Content-Type: application/json; charset=utf-8

# The admin portal (admin.html + /api/admin/*): never indexed, never framed, no referrer.
/admin
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
/admin.html
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
