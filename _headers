# Always-fresh code (beats iPhone caching)
/*
  Cache-Control: no-store, no-cache, must-revalidate

# Media cached hard
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The CLEANSLATE version manifest: the plug-in's CHECK FOR UPDATE and /updatecleanslate read it.
# Root files are already no-store (above); this pins the type and documents the intent.
/cleanslate-version.json
  Cache-Control: no-store, no-cache, must-revalidate
  Content-Type: application/json; charset=utf-8

# The /listen manifest: js/listen.js reads it for every link + the stream total.
# Root files are already no-store (above); this pins the type and documents the intent.
/listen.json
  Cache-Control: no-store, no-cache, must-revalidate
  Content-Type: application/json; charset=utf-8
