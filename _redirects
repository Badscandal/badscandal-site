# Licence server behind our own domain: the CLEANSLATE plug-in (from build b3) and activate.html
# talk to /api/licence/* when the Cloudflare workers.dev name is unreachable from a buyer's machine.
/api/licence/*  https://cleanslate-licence.luke-86a.workers.dev/:splat  200

# Old music-era URLs. Keep these: they are indexed and linked from
# elsewhere, and Netlify serves this file before it 404s.
/lukepower      /us      301
/lukepower.html /us      301
/live           /        301
/live.html      /        301

# Our own visit counter (js/track.js -> /api/hit, numbers at /stats). Put these in bios so the
# source is certain: badscandal.com/ig in the Instagram bio, /tt on TikTok, /yt on YouTube.
/ig  /listen?src=ig      302
/tt  /listen?src=tiktok  302
/yt  /listen?src=youtube 302

# Server-side files that sit in the published root: never serve them.
/package.json       /404  404!
/package-lock.json  /404  404!
/netlify/*          /404  404!
